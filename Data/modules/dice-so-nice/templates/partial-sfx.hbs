<li class="sfx flexrow sfx-line" data-sfx-mode="{{#if isAdvanced}}advanced{{else}}basic{{/if}}">
    <input type="hidden" name="sfxLine[{{id}}][mode]" data-sfx-mode-input value="{{#if isAdvanced}}advanced{{else}}basic{{/if}}" />
    {{#if isAdvanced}}
    <div class="sfx-data sfx-flex-7 sfx-formula-container">
        <input type="text" data-sfx-formula name="sfxLine[{{id}}][formula]" value="{{formula}}" placeholder="{{localize 'DICESONICE.sfxFormulaPlaceholder'}}" autocomplete="off" />
        <i class="fas fa-circle-exclamation sfx-formula-error-icon" data-sfx-formula-error></i>
    </div>
    {{else}}
    <div class="sfx-data sfx-flex-2">
        <select data-sfx-dicetype name="sfxLine[{{id}}][diceType]">
            {{selectOptions triggerTypeList selected=diceType valueAttr="id" labelAttr="name"}}
        </select>
    </div>
    <div class="sfx-data sfx-flex-5">
        <select data-sfx-result data-sfx-result-dicetype="{{diceType}}" name="sfxLine[{{id}}][onResult]" multiple>
            {{selectOptions possibleResultList selected=onResult valueAttr="id" labelAttr="id"}}
        </select>
    </div>
    {{/if}}
    <div class="sfx-data sfx-flex-3">
        <select data-sfx-specialeffect name="sfxLine[{{id}}][specialEffect]">
            {{selectOptions specialEffectsMode selected=specialEffect localize=true}}
        </select>
    </div>
    <div class="hidden sfx-hidden">
        <div data-sfx-hidden-options>
            {{{options}}}
        </div>
    </div>
    <div class="sfx-controls">
        <a class="sfx-control" data-sfx-mode-toggle title='{{localize "DICESONICE.sfxModeToggle"}}'><i class="fas fa-{{#if isAdvanced}}list{{else}}code{{/if}}"></i></a>
        <a class="sfx-control" data-sfx-options title='{{localize "DICESONICE.Options"}}'><i class="fas fa-cog"></i></a>
        <a class="sfx-control" data-sfx-delete title='{{localize "DICESONICE.Delete"}}'><i class="fas fa-trash"></i></a>
    </div>
</li>
