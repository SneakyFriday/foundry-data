<div class="tab tabAppearance" data-tab="{{dicetype}}" data-group="dsn-dice">
    <div class="form-group" data-system-group>
        <label>{{localize "DICESONICE.system"}}</label>
        <div class="form-fields">
            <select data-system data-dicetype="{{dicetype}}" name="appearance[{{dicetype}}][system]">
                {{#if roleMode}}{{selectOptions systemList selected=appearance.system blank=inheritLabel}}{{else}}{{selectOptions systemList selected=appearance.system}}{{/if}}
            </select>
            <a class="system-control {{systemSettingsVisible}}" data-system-options title='{{localize "DICESONICE.Options"}}'><i class="fas fa-cog"></i></a>
        </div>
    </div>

    {{#if showLibrary}}
    <div class="form-group" data-library-group>
        <label>{{localize "DICESONICE.libraryDie"}}</label>
        <div class="form-fields">
            <select data-libraryDie data-dicetype="{{dicetype}}" name="appearance[{{dicetype}}][libraryDieId]">
                <option value="">{{localize "DICESONICE.None"}}</option>
                {{#each libraryDiceGroups}}
                <optgroup label="{{this.label}}">
                    {{#each this.dice}}
                    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
                    {{/each}}
                </optgroup>
                {{/each}}
            </select>
            <a class="library-control" data-library-manage data-dicetype="{{dicetype}}" title='{{localize "DICESONICE.diceLibrary"}}'><i class="fas fa-book"></i></a>
        </div>
    </div>
    {{/if}}

    <div class="form-group">
        <label>{{localize "DICESONICE.colorset"}}</label>
        <div class="form-fields">
            <select data-colorset data-dicetype="{{dicetype}}" name="appearance[{{dicetype}}][colorset]">
                {{#if roleMode}}{{selectOptions colorsetList selected=appearance.colorset localize=true blank=inheritLabel}}{{else}}{{selectOptions colorsetList selected=appearance.colorset localize=true}}{{/if}}
            </select>
        </div>
        <p class="hint">{{localize "DICESONICE.colorsetDesc"}}</p>
    </div>

    <div class="form-group">
        <label>{{localize "DICESONICE.texture"}}</label>
        <div class="form-fields">
            <select data-texture data-dicetype="{{dicetype}}" name="appearance[{{dicetype}}][texture]">
                {{#if roleMode}}{{selectOptions textureList selected=appearance.texture blank=inheritLabel}}{{else}}{{selectOptions textureList selected=appearance.texture}}{{/if}}
            </select>
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "DICESONICE.material"}}</label>
        <div class="form-fields">
            <select data-material data-dicetype="{{dicetype}}" name="appearance[{{dicetype}}][material]">
                {{#if roleMode}}{{selectOptions materialList selected=appearance.material blank=inheritLabel}}{{else}}{{selectOptions materialList selected=appearance.material}}{{/if}}
            </select>
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "DICESONICE.font"}}</label>
        <div class="form-fields">
            <select data-font data-dicetype="{{dicetype}}" name="appearance[{{dicetype}}][font]">
                {{#if roleMode}}{{selectOptions fontList selected=appearance.font blank=inheritLabel}}{{else}}{{selectOptions fontList selected=appearance.font}}{{/if}}
            </select>
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "DICESONICE.labelColor"}}</label>
        <div class="form-fields">
            <input type="text" data-labelColor data-dicetype="{{dicetype}}" name="appearance[{{dicetype}}][labelColor]" value="{{appearance.labelColor}}" data-dtype="String" />
            <input type="color" class="{{inheritCls.labelColor}}" name="appearance[{{dicetype}}][labelColorSelector]" value="{{preview.labelColor}}"
                data-edit="appearance[{{dicetype}}][labelColor]" data-labelColorSelector />
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "DICESONICE.diceColor"}}</label>
        <div class="form-fields">
            <input type="text" data-diceColor data-dicetype="{{dicetype}}" name="appearance[{{dicetype}}][diceColor]" value="{{appearance.diceColor}}" data-dtype="String" />
            <input type="color" class="{{inheritCls.diceColor}}" name="appearance[{{dicetype}}][diceColorSelector]" value="{{preview.diceColor}}"
                data-edit="appearance[{{dicetype}}][diceColor]" data-diceColorSelector />
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "DICESONICE.outlineColor"}}</label>
        <div class="form-fields">
            <input type="text" data-outlineColor data-dicetype="{{dicetype}}" name="appearance[{{dicetype}}][outlineColor]" value="{{appearance.outlineColor}}"
                data-dtype="String" />
            <input type="color" class="{{inheritCls.outlineColor}}" name="appearance[{{dicetype}}][outlineColorSelector]" value="{{preview.outlineColor}}"
                data-edit="appearance[{{dicetype}}][outlineColor]" data-outlineColorSelector />
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "DICESONICE.edgeColor"}}</label>
        <div class="form-fields">
            <input type="text" data-edgeColor data-dicetype="{{dicetype}}" name="appearance[{{dicetype}}][edgeColor]" value="{{appearance.edgeColor}}" data-dtype="String" />
            <input type="color" class="{{inheritCls.edgeColor}}" name="appearance[{{dicetype}}][edgeColorSelector]" value="{{preview.edgeColor}}"
                data-edit="appearance[{{dicetype}}][edgeColor]" data-edgeColorSelector />
        </div>
    </div>
    <div class="dsn-hidden">
        <div data-systemSettings-hidden>
            {{{systemSettings}}}
        </div>
    </div>
</div>