<form autocomplete="off" onsubmit="event.preventDefault();">
    <p class="notes">{{localize "DICESONICE.GMPushDialogHint"}}</p>
    <div class="form-group">
        <label>
            <input type="checkbox" name="appearance" checked />
            {{localize "DICESONICE.GMPushAppearance"}}
        </label>
    </div>
    <div class="form-group">
        <label>
            <input type="checkbox" name="sfxList" />
            {{localize "DICESONICE.GMPushSFX"}}
        </label>
    </div>
    <div class="form-group">
        <label>
            <input type="checkbox" name="settings" />
            {{localize "DICESONICE.GMPushSettings"}}
        </label>
    </div>
    <p class="notes"><strong>{{localize "DICESONICE.GMPushWarning"}}</strong></p>
</form>
