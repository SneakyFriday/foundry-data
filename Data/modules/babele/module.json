{
	"id": "babele",
	"title": "Babele",
	"description": "Module allowing a 'runtime' translation of all the installed compendiums",
	"version": "2.9.1",
	"compatibility": {
		"minimum": 13,
		"verified": "14"
	},
	"relationships": {
		"requires": [
			{
				"id": "lib-wrapper",
				"type": "module"
			}
		]
	},
	"authors": [
		{
			"name": "Simone",
			"email": "simone.ricciardi@gmail.com",
			"discord": "Simone [UTC +1]#6710"
		}
	],
	"esmodules": [
		"script/babele.js"
	],
	"scripts": [
		"lib/jszip.min.js",
		"lib/FileSaver.js"
	],
	"styles": [
		"styles/babele.css"
	],
	"languages": [
		{
			"lang": "ar",
			"name": "Arabic",
			"path": "./lang/ar.json"
		},
		{
			"lang": "en",
			"name": "English",
			"path": "./lang/en.json"
		},
		{
			"lang": "it",
			"name": "Italian",
			"path": "./lang/it.json"
		},
		{
			"lang": "es",
			"name": "Español",
			"path": "./lang/es.json"
		},
		{
			"lang": "de",
			"name": "Deutsch (German)",
			"path": "./lang/de.json"
		},
		{
			"lang": "fr",
			"name": "Français",
			"path": "./lang/fr.json"
		},
		{
			"lang": "pl",
			"name": "Polski",
			"path": "./lang/pl.json"
		},
		{
			"lang": "zh-tw",
			"name": "Taiwanese",
			"path": "./lang/zh-tw.json"
		},
		{
			"lang": "ja",
			"name": "日本語",
			"path": "./lang/ja.json"
		}
	],
	"media": [
		{
			"type": "setup",
			"url": "modules/babele/media/cover.webp",
			"thumbnail": "modules/babele/media/cover.webp"
		}
	],
	"url": "https://gitlab.com/riccisi/foundryvtt-babele",
	"manifest": "https://gitlab.com/riccisi/foundryvtt-babele/-/jobs/artifacts/2.9.1/raw/module/module.json?job=build",
	"download": "https://gitlab.com/riccisi/foundryvtt-babele/-/jobs/artifacts/2.9.1/raw/babele.zip?job=build"
}
